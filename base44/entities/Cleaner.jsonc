{
  "name": "Cleaner",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID of the cleaner"
    },
    "business_name": {
      "type": "string",
      "description": "Cleaner or cleaning business name"
    },
    "bio": {
      "type": "string",
      "description": "Profile description"
    },
    "profile_photo": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "portfolio_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Work portfolio images"
    },
    "service_area": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "postcode_prefix": {
          "type": "string"
        },
        "radius_miles": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Service coverage area"
    },
    "base_price": {
      "type": "number",
      "description": "Base cleaning price"
    },
    "price_per_bedroom": {
      "type": "number",
      "default": 0,
      "description": "Additional charge per bedroom"
    },
    "price_per_bathroom": {
      "type": "number",
      "default": 0,
      "description": "Additional charge per bathroom"
    },
    "minimum_charge": {
      "type": "number",
      "description": "Minimum job charge"
    },
    "rate_card": {
      "type": "object",
      "description": "Fixed prices by property size",
      "properties": {
        "studio_1bed": {
          "type": "number",
          "default": 0
        },
        "two_bed": {
          "type": "number",
          "default": 0
        },
        "three_bed": {
          "type": "number",
          "default": 0
        },
        "four_bed_plus": {
          "type": "number",
          "default": 0
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "laundry": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "price": {
              "type": "number",
              "default": 0
            },
            "pricing_type": {
              "type": "string",
              "enum": [
                "per_job",
                "per_load"
              ],
              "default": "per_job"
            }
          }
        },
        "linen_change": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "price": {
              "type": "number",
              "default": 0
            }
          }
        },
        "deep_cleaning": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "price": {
              "type": "number",
              "default": 0
            }
          }
        },
        "urgency_premium": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "percentage": {
              "type": "number",
              "default": 0
            }
          }
        }
      }
    },
    "dynamic_pricing": {
      "type": "object",
      "description": "Dynamic pricing rules for last-minute and seasonal demand",
      "properties": {
        "last_minute": {
          "type": "object",
          "description": "Last-minute urgency pricing tiers",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "tiers": {
              "type": "array",
              "description": "Each tier defines a days_before threshold and a % uplift",
              "items": {
                "type": "object",
                "properties": {
                  "days_before": {
                    "type": "number",
                    "description": "Booking is within this many days of the clean date"
                  },
                  "uplift_percent": {
                    "type": "number",
                    "description": "% increase to apply"
                  },
                  "label": {
                    "type": "string",
                    "description": "Display label e.g. Same day"
                  }
                }
              }
            }
          }
        },
        "seasonal": {
          "type": "object",
          "description": "Seasonal demand multipliers",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "windows": {
              "type": "array",
              "description": "Date windows with a multiplier",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "description": "e.g. Summer Peak, Christmas"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "multiplier": {
                    "type": "number",
                    "description": "e.g. 1.2 = 20% uplift"
                  }
                }
              }
            }
          }
        }
      }
    },
    "average_duration_hours": {
      "type": "number",
      "default": 2,
      "description": "Typical cleaning duration"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Identity verified"
    },
    "insurance_verified": {
      "type": "boolean",
      "default": false,
      "description": "Insurance coverage verified"
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_jobs": {
      "type": "number",
      "default": 0
    },
    "acceptance_rate": {
      "type": "number",
      "default": 100,
      "description": "Percentage of accepted jobs"
    },
    "response_time_minutes": {
      "type": "number",
      "default": 0,
      "description": "Average response time"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "none",
        "basic",
        "pro"
      ],
      "default": "none"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial"
      ],
      "default": "inactive"
    },
    "subscription_expires": {
      "type": "string",
      "format": "date"
    },
    "auto_accept_jobs": {
      "type": "boolean",
      "default": false,
      "description": "Auto-accept job requests (Pro only)"
    },
    "max_jobs_per_day": {
      "type": "number",
      "default": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "suspended"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "business_name",
    "base_price"
  ]
}