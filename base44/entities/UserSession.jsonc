{
  "name": "UserSession",
  "type": "object",
  "properties": {
    "session_token": {
      "type": "string",
      "description": "Unique session token"
    },
    "email": {
      "type": "string",
      "description": "User email address"
    },
    "role": {
      "type": "string",
      "description": "User role"
    },
    "founding_member_id": {
      "type": "string",
      "description": "Reference to FoundingMember record"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Session expiry timestamp"
    },
    "user_id": {
      "type": "string",
      "description": "User ID reference"
    }
  },
  "required": [
    "session_token",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}