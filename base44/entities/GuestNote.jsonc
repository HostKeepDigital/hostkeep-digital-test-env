{
  "name": "GuestNote",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Guest reference"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff who added note"
    },
    "content": {
      "type": "string",
      "description": "Note content"
    }
  },
  "required": [
    "guest_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}