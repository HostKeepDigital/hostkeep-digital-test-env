{
  "name": "MarketPricing",
  "type": "object",
  "properties": {
    "postcode_area": {
      "type": "string",
      "description": "e.g. TR, PL, EX"
    },
    "town": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "description": "e.g. cottage, apartment, lodge, house, chalet, cabin"
    },
    "bedrooms": {
      "type": "number",
      "description": "Number of bedrooms \u2014 key differentiator for pricing"
    },
    "guest_capacity": {
      "type": "number",
      "description": "Max guests this data applies to"
    },
    "avg_nightly_rate": {
      "type": "number",
      "description": "Average competitor nightly rate \u00a3 for this spec"
    },
    "min_nightly_rate": {
      "type": "number"
    },
    "max_nightly_rate": {
      "type": "number"
    },
    "median_nightly_rate": {
      "type": "number"
    },
    "sample_size": {
      "type": "number",
      "description": "Number of listings analysed"
    },
    "avg_occupancy_rate": {
      "type": "number",
      "description": "Estimated % annual occupancy"
    },
    "peak_months": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Months with highest demand"
    },
    "low_months": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Months with lowest demand"
    },
    "weekend_premium_pct": {
      "type": "number",
      "description": "Typical % premium for weekend stays"
    },
    "monthly_rate_index": {
      "type": "object",
      "description": "Month name to rate multiplier e.g. {July: 1.4, January: 0.7}"
    },
    "key_insights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actionable bullet points specific to this property spec"
    },
    "positioning_advice": {
      "type": "string",
      "description": "Narrative pricing strategy for this specific property type/size"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Platforms searched (Airbnb, Sykes, etc.)"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_stale": {
      "type": "boolean",
      "default": false,
      "description": "True when superseded by a newer scrape for same spec"
    }
  },
  "required": [
    "postcode_area",
    "property_type",
    "avg_nightly_rate"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}