{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID of subscriber"
    },
    "plan": {
      "type": "string",
      "enum": [
        "host_starter_monthly",
        "host_growth_monthly",
        "host_pro_monthly",
        "cleaner_solo_monthly",
        "cleaner_pro_monthly",
        "cleaner_team_monthly",
        "beta_host_access",
        "beta_cleaner_access",
        "founding_host_solo",
        "founding_host_multi",
        "founding_host_portfolio",
        "founding_cleaner_solo"
      ],
      "description": "Subscription plan"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "trial"
      ],
      "default": "trial"
    },
    "price_monthly": {
      "type": "number"
    },
    "max_properties": {
      "type": "number",
      "description": "Maximum properties allowed"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "trial_ends": {
      "type": "string",
      "format": "date"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is a founding member with locked-in pricing"
    },
    "founding_plan_id": {
      "type": "string",
      "description": "References the founding pricing tier they're locked into"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "plan"
  ]
}