{
  "name": "Channel",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier for the channel (e.g., airbnb, booking_com, vrbo, direct)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable channel name"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}