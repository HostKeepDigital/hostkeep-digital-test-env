{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_user_id": {
      "type": "string",
      "description": "The host who shared the referral link"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the referring host"
    },
    "referee_email": {
      "type": "string",
      "description": "Email of the person who signed up"
    },
    "referee_user_id": {
      "type": "string",
      "description": "Set when the referee's account is confirmed"
    },
    "ref_code": {
      "type": "string",
      "description": "The unique referral code"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Current status of the referral"
    },
    "referee_name": {
      "type": "string",
      "description": "Display name of the person who signed up"
    },
    "completed_at": {
      "type": "string",
      "format": "date",
      "description": "Date when the referral was completed and rewards applied"
    }
  },
  "required": [
    "referrer_user_id",
    "ref_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referee_user_id": "{{user.id}}"
        },
        {
          "data.referee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referee_user_id": "{{user.id}}"
        },
        {
          "data.referee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referee_user_id": "{{user.id}}"
        },
        {
          "data.referee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}