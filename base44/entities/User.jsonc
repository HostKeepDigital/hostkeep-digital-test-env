{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "notification_preferences": {
      "type": "object"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account ID"
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "pending",
        "pending_verification",
        "verified"
      ],
      "default": "not_connected",
      "description": "Stripe Connect onboarding status"
    },
    "account_flagged": {
      "type": "boolean",
      "default": false,
      "description": "true when admin or system has flagged this account for review"
    },
    "account_flag_reason": {
      "type": "string",
      "description": "the reason the account was flagged"
    },
    "account_flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "when the flag was set"
    }
  },
  "required": []
}