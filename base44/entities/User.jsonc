{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "forename": {
      "type": "string",
      "description": "First name"
    },
    "middle_name": {
      "type": "string",
      "description": "Middle name (optional)"
    },
    "surname": {
      "type": "string",
      "description": "Surname"
    },
    "phone": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "notification_preferences": {
      "type": "object"
    },
    "signup_postcode": {
      "type": "string",
      "description": "Postcode provided at signup (copied from FoundingMember onboarding record)"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "True if this user signed up as a founding member \u2014 unlocks founding badge and founding subscriptions"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account ID"
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "pending",
        "pending_verification",
        "verified"
      ],
      "default": "not_connected",
      "description": "Stripe Connect onboarding status"
    },
    "account_flagged": {
      "type": "boolean",
      "default": false,
      "description": "true when admin or system has flagged this account for review"
    },
    "account_flag_reason": {
      "type": "string",
      "description": "the reason the account was flagged"
    },
    "account_flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "when the flag was set"
    }
  },
  "required": []
}