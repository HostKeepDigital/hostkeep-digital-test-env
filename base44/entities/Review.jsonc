{
  "name": "Review",
  "type": "object",
  "properties": {
    "review_category": {
      "type": "string",
      "enum": [
        "booking",
        "cleaning_job"
      ],
      "default": "booking",
      "description": "Whether this review is for a booking or a cleaning job"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking (if booking review)"
    },
    "job_id": {
      "type": "string",
      "description": "Related cleaning job (if job review)"
    },
    "property_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewee_id": {
      "type": "string",
      "description": "User being reviewed"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "guest_to_host",
        "host_to_guest",
        "host_to_cleaner",
        "cleaner_to_host"
      ],
      "description": "Direction of review"
    },
    "rating": {
      "type": "number",
      "description": "Overall 1\u20135 star rating"
    },
    "cleanliness_rating": {
      "type": "number",
      "description": "Cleanliness (guest\u2192host)"
    },
    "communication_rating": {
      "type": "number",
      "description": "Communication"
    },
    "location_rating": {
      "type": "number",
      "description": "Location (guest\u2192host)"
    },
    "value_rating": {
      "type": "number",
      "description": "Value for money (guest\u2192host)"
    },
    "punctuality_rating": {
      "type": "number",
      "description": "Punctuality/on-time (host\u2192cleaner)"
    },
    "quality_rating": {
      "type": "number",
      "description": "Cleaning quality (host\u2192cleaner)"
    },
    "reliability_rating": {
      "type": "number",
      "description": "Reliability (host\u2192cleaner)"
    },
    "payment_promptness_rating": {
      "type": "number",
      "description": "Payment on time (cleaner\u2192host)"
    },
    "professionalism_rating": {
      "type": "number",
      "description": "Host professionalism (cleaner\u2192host)"
    },
    "was_late": {
      "type": "boolean",
      "description": "Whether cleaner arrived late (host\u2192cleaner)"
    },
    "notice_given": {
      "type": "boolean",
      "description": "Whether adequate notice was given for changes (cleaner\u2192host)"
    },
    "comment": {
      "type": "string"
    },
    "host_response": {
      "type": "string",
      "description": "Response from the reviewee"
    },
    "blind_until": {
      "type": "string",
      "format": "date-time",
      "description": "Reviews are hidden from each other until this date (7 days after booking/job end)"
    },
    "both_reviewed": {
      "type": "boolean",
      "default": false,
      "description": "True when both parties have submitted a review \u2014 reveals early"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether this review is visible to its recipient"
    },
    "public_visible": {
      "type": "boolean",
      "default": false,
      "description": "Whether this review is shown publicly (set by processReview)"
    },
    "review_window_expired": {
      "type": "boolean",
      "default": false,
      "description": "Set to true after 7 days if the counterpart never reviewed \u2014 they lose the option"
    },
    "performance_flag": {
      "type": "boolean",
      "default": false,
      "description": "Admin flag: poor review on first-time reviewee"
    },
    "reminder_3day_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_7day_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reviewer_id",
    "review_type",
    "rating"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.public_visible": true
        },
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "data.reviewee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "data.reviewee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}