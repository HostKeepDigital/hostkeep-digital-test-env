{
  "name": "GuestIncident",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Guest reference"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "damage",
        "rule_violation",
        "noise_complaint",
        "no_show"
      ],
      "description": "Type of incident"
    },
    "description": {
      "type": "string",
      "description": "Incident details"
    },
    "logged_by": {
      "type": "string",
      "description": "Staff who logged incident"
    }
  },
  "required": [
    "guest_id",
    "incident_type",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.guest_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}