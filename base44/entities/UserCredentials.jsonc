{
  "name": "UserCredentials",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "User email address"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "founding_member_id": {
      "type": "string",
      "description": "Reference to FoundingMember record"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has verified their email address via code"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity record"
    }
  },
  "required": [
    "email",
    "password_hash"
  ],
  "rls": {
    "create": {
      "data.email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}