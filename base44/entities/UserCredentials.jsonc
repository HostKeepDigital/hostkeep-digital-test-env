{
  "name": "UserCredentials",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "User email address"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "founding_member_id": {
      "type": "string",
      "description": "Reference to FoundingMember record"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has verified their email address via code"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity record"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Consecutive failed login attempts \u2014 reset to 0 on successful sign-in"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Account locked until this ISO timestamp after 5 failed attempts. Null means not locked."
    }
  },
  "required": [
    "email",
    "password_hash"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}