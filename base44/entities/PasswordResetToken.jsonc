{
  "name": "PasswordResetToken",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "token": {
      "type": "string",
      "description": "Reset token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When token expires"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether token has been used"
    }
  },
  "required": [
    "user_id",
    "email",
    "token",
    "expires_at"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}