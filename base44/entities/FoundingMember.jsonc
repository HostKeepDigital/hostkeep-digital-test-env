{
  "name": "FoundingMember",
  "type": "object",
  "properties": {
    "forename": {
      "type": "string",
      "description": "Forename of the founding member"
    },
    "middle_name": {
      "type": "string",
      "description": "Middle name of the founding member"
    },
    "surname": {
      "type": "string",
      "description": "Surname of the founding member"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "cleaner"
      ],
      "description": "Role applying for"
    },
    "postcode": {
      "type": "string",
      "description": "Property/home postcode"
    },
    "phone": {
      "type": "string",
      "description": "Phone number (onboarding record)"
    },
    "location": {
      "type": "string",
      "description": "Location / town (onboarding record)"
    },
    "signup_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When they signed up"
    },
    "onboarding_token": {
      "type": "string",
      "description": "Unique onboarding token for password creation"
    },
    "onboarding_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the onboarding token expires"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the created User account"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "interest",
        "pending",
        "invited",
        "password_protected",
        "awaiting_document_verification",
        "documentation_failed_attempt_1",
        "documentation_failed_attempt_2",
        "approved",
        "waitlist",
        "rejected",
        "rejected_pending_application",
        "out_of_area",
        "banned_email_verification",
        "banned_documentation_failure",
        "banned_fraud",
        "banned_manual_admin_action",
        "banned"
      ],
      "default": "interest",
      "description": "Admin approval + onboarding status."
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason recorded when a member is banned"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member has verified their email address"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": true,
      "description": "Founding member badge flag"
    },
    "documents_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the member last submitted their verification documents"
    },
    "ref_code": {
      "type": "string",
      "description": "Referral code used when signing up, if any"
    }
  },
  "required": [
    "forename",
    "surname",
    "email",
    "role",
    "postcode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}