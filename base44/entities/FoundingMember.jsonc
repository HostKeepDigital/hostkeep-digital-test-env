{
  "name": "FoundingMember",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name of the founding member (onboarding record only)"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "cleaner"
      ],
      "description": "Role applying for"
    },
    "postcode": {
      "type": "string",
      "description": "Property/home postcode"
    },
    "phone": {
      "type": "string",
      "description": "Phone number (onboarding record)"
    },
    "location": {
      "type": "string",
      "description": "Location / town (onboarding record)"
    },
    "signup_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When they signed up"
    },
    "onboarding_token": {
      "type": "string",
      "description": "Unique onboarding token for password creation"
    },
    "onboarding_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the onboarding token expires"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the created User account"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "interest",
        "pending_application",
        "invited",
        "password_protected",
        "awaiting_document_verification",
        "documentation_failed_attempt_1",
        "documentation_failed_attempt_2",
        "guest_pending_application",
        "approved"
      ],
      "default": "interest",
      "description": "Admin approval + onboarding status."
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason recorded when a member is banned"
    },
    "documents_verified": {
      "type": "boolean",
      "default": false,
      "description": "Admin has approved the member's verification documents"
    },
    "documents_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the member last submitted their verification documents"
    },
    "stripe_verified": {
      "type": "boolean",
      "default": false,
      "description": "Stripe Connect account is connected and charges enabled"
    },
    "subscription_active": {
      "type": "boolean",
      "default": false,
      "description": "Member has an active HostKeep subscription"
    },
    "ref_code": {
      "type": "string",
      "description": "Referral code used when signing up, if any"
    }
  },
  "required": [
    "full_name",
    "email",
    "role",
    "postcode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}