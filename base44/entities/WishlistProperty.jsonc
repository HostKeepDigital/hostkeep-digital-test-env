{
  "name": "WishlistProperty",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who wishlisted the property"
    },
    "property_id": {
      "type": "string",
      "description": "Property reference"
    }
  },
  "required": [
    "user_id",
    "property_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}