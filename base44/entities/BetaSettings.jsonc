{
  "name": "BetaSettings",
  "type": "object",
  "properties": {
    "beta_open": {
      "type": "boolean",
      "default": true,
      "description": "When true, all host/cleaner applications go through the founding member flow. Set to false post-beta to open standard onboarding."
    },
    "beta_end_date": {
      "type": "string",
      "format": "date",
      "description": "Date when beta period ends and founding members transition to paid tiers"
    },
    "emails_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when transition emails were sent"
    },
    "emails_sent_count": {
      "type": "number",
      "default": 0,
      "description": "Number of transition emails sent"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}